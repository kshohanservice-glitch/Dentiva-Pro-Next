{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist/main",
    "rootDir": "src",
    "sourceMap": true,
    "isolatedModules": false
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*"
  ]
}
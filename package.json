{
  "name": "dentiva-pro",
  "productName": "Dentiva Pro",
  "version": "2.0.2",
  "description": "Dentiva Pro — offline dental clinic management software for Windows",
  "author": "Shohan Khan <helloiamshohan@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "build:main": "tsc -p tsconfig.node.json && node scripts/bundle-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:main && npm run build:renderer -- --mode e2e && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && npm run prepare:argon2 && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && npm run prepare:argon2 && electron-builder --win nsis --publish never --config.directories.output=dist",
    "prepare:argon2": "node scripts/prepare-argon2-win.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-bengali": "^5.1.0",
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "unzipper": "^0.12.3",
    "@node-rs/argon2-win32-x64-msvc": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/unzipper": "^0.10.10",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.2"
  }
}
